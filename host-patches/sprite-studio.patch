+import type { FastifyInstance } from "fastify";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { createHash } from "node:crypto";
+import { DATA_DIR } from "../utils/data-dir.js";
+import { createConnectionsStorage } from "../services/storage/connections.storage.js";
+import { generateImage, resumeComfyUiImage, resolveImageBackend } from "../services/image/image-generation.js";
+import { resumeRunPodImage } from "../services/image/runpod-comfyui.service.js";
+import type { ImageGenResult } from "@marinara-engine/shared";
+import {
+  resolveConnectionImageDefaults,
+  resolveConnectionImageQuality,
+} from "../services/image/image-generation-defaults.js";
+import { getSharp } from "../services/image/sharp-runtime.js";
+import { studioCanvases, planStudioSheets } from "../services/image/sprite-studio.js";
+import { logger } from "../lib/logger.js";
+
+const assetPattern = /^villages-[a-f0-9-]{36}$/i;
+const root = join(DATA_DIR, "sprites");
+async function saveResult(assetId: string, image: ImageGenResult, connectionId: string, model: string | null) {
+  if (!["png", "jpg", "jpeg", "webp"].includes(image.ext))
+    throw new Error("The image model returned an unsupported sprite format.");
+  const dir = join(root, assetId);
+  const filename = `original.${image.ext}`;
+  const bytes = Buffer.from(image.base64, "base64");
+  try {
+    await writeFile(join(dir, filename), bytes, { flag: "wx" });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+  }
+  const size = await (await getSharp())(await readFile(join(dir, filename))).metadata();
+  const result = {
+    url: `/api/sprites/${assetId}/file/${filename}`,
+    width: size.width,
+    height: size.height,
+    attempts: 1,
+    usage: image.usage ?? null,
+    connectionId,
+    model,
+  };
+  await writeFile(join(dir, "studio-receipt.json"), JSON.stringify(result));
+  return result;
+}
+
+export async function spriteStudioRoutes(app: FastifyInstance) {
+  const connection = async (id: unknown) => {
+    if (typeof id !== "string" || !id) throw new Error("Choose an image connection.");
+    const conn = await createConnectionsStorage(app.db).getWithKey(id);
+    if (!conn || conn.provider !== "image_generation") throw new Error("The selected image connection is unavailable.");
+    const source = resolveImageBackend(
+      conn.model || "",
+      conn.baseUrl || "",
+      conn.imageService || conn.imageGenerationSource || "",
+    );
+    if (["comfyui", "runpod_comfyui"].includes(source)) {
+      const workflow = conn.comfyuiWorkflow || "";
+      if (
+        !/%reference_image(?:_name)?(?:_1)?%/.test(workflow) ||
+        !workflow.includes("%width%") ||
+        !workflow.includes("%height%")
+      )
+        throw new Error(
+          "Sprite Studio needs a ComfyUI workflow with reference_image (or reference_image_name), width, and height placeholders.",
+        );
+    }
+    return conn;
+  };
+  const configurationToken = (conn: Awaited<ReturnType<typeof connection>>) =>
+    createHash("sha256")
+      .update(
+        JSON.stringify({
+          id: conn.id,
+          model: conn.model,
+          baseUrl: conn.baseUrl,
+          source: conn.imageService || conn.imageGenerationSource,
+          defaults: resolveConnectionImageDefaults(conn),
+          quality: resolveConnectionImageQuality(conn),
+          workflow: conn.comfyuiWorkflow,
+          endpoint: conn.imageEndpointId,
+        }),
+      )
+      .digest("hex");
+  app.post("/studio/plan", async (req, reply) => {
+    try {
+      const body = req.body as { connectionId?: string; count?: number; individual?: boolean };
+      const conn = await connection(body.connectionId);
+      const source = resolveImageBackend(
+        conn.model || "",
+        conn.baseUrl || "",
+        conn.imageService || conn.imageGenerationSource || "",
+      );
+      return {
+        protocol: 1,
+        providerToken: configurationToken(conn),
+        connection: { id: conn.id, name: conn.name, model: conn.model, source },
+        batches: planStudioSheets(body.count ?? 1, studioCanvases(conn.model || "", source), body.individual === true),
+        estimatedCost: null,
+        usageAvailable: false,
+        localWorkflow: ["comfyui", "swarmui", "automatic1111", "runpod_comfyui"].includes(source),
+        recovery: ["comfyui", "runpod_comfyui"].includes(source),
+        sizes: studioCanvases(conn.model || "", source),
+        maxSheetCells: 6,
+        automaticRetries: false,
+        customParametersIgnored: Boolean(
+          Object.keys(resolveConnectionImageDefaults(conn)?.customParameters ?? {}).length,
+        ),
+      };
+    } catch (error) {
+      return reply.code(400).send({ error: error instanceof Error ? error.message : "Cannot plan sprites." });
+    }
+  });
+  // This endpoint is deliberately raw: persist the paid result before any cleanup or cropping.
+  // The caller owns review and approval. A durable marker forbids ambiguous resubmissions.
+  app.post("/studio/generate", { bodyLimit: 16_000_000 }, async (req, reply) => {
+    let attempted = false;
+    try {
+      const body = req.body as {
+        connectionId?: string;
+        expectedModel?: string;
+        providerToken?: string;
+        assetId?: string;
+        prompt?: string;
+        reference?: string;
+        width?: number;
+        height?: number;
+        debugMode?: boolean;
+      };
+      if (!body.assetId || !assetPattern.test(body.assetId)) throw new Error("Invalid studio asset id.");
+      if (typeof body.prompt !== "string" || !body.prompt.trim() || body.prompt.length > 16000)
+        throw new Error("Invalid studio prompt.");
+      const conn = await connection(body.connectionId);
+      if (body.expectedModel !== conn.model)
+        throw new Error("The image model changed. Review a new plan before generating.");
+      if (body.providerToken !== configurationToken(conn))
+        throw new Error("The image connection settings changed. Review a new plan before generating.");
+      const sizes = studioCanvases(
+        conn.model || "",
+        resolveImageBackend(
+          conn.model || "",
+          conn.baseUrl || "",
+          conn.imageService || conn.imageGenerationSource || "",
+        ),
+      );
+      if (!sizes.some((size) => size.width === body.width && size.height === body.height))
+        throw new Error("Re-plan this image size before generating.");
+      const dir = join(root, body.assetId);
+      await mkdir(dir, { recursive: true });
+      const receiptPath = join(dir, "studio-receipt.json");
+      try {
+        return JSON.parse(await readFile(receiptPath, "utf8"));
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      }
+      // References are local immutable sprite files, never arbitrary URLs.
+      let reference: string | undefined;
+      if (body.reference) {
+        const match =
+          /^\/api\/sprites\/(villages-[a-f0-9-]{36})\/file\/([a-z0-9_-]{1,40}\.(?:png|jpg|jpeg|webp))$/i.exec(
+            body.reference,
+          );
+        if (!match) throw new Error("Invalid studio reference.");
+        const bytes = await readFile(join(root, match[1]!, match[2]!));
+        if (bytes.length > 12_000_000) throw new Error("Reference image is too large.");
+        reference = bytes.toString("base64");
+      }
+      try {
+        await writeFile(
+          join(dir, "studio-attempt.json"),
+          JSON.stringify({ at: new Date().toISOString(), connectionId: conn.id, model: conn.model }),
+          { flag: "wx" },
+        );
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "EEXIST")
+          return reply.code(409).send({
+            error: "This image was already submitted. Its outcome may be unknown; do not automatically retry.",
+            attempts: null,
+          });
+        throw error;
+      }
+      attempted = true;
+      const defaults = resolveConnectionImageDefaults(conn);
+      const image = await generateImage(
+        conn.model || "",
+        conn.baseUrl || "",
+        conn.apiKey || "",
+        conn.imageService || conn.imageGenerationSource || "",
+        {
+          model: conn.model || "",
+          prompt: body.prompt,
+          width: body.width,
+          height: body.height,
+          referenceImage: reference,
+          transparentBackground: true,
+          imageEndpointId: conn.imageEndpointId || undefined,
+          comfyWorkflow: conn.comfyuiWorkflow || undefined,
+          imageDefaults: defaults ? { ...defaults, customParameters: undefined } : defaults,
+          quality: resolveConnectionImageQuality(conn),
+          allowRetries: false,
+          debugMode: body.debugMode === true,
+          onProviderJob: async (job) => {
+            await writeFile(
+              join(dir, "studio-provider-job.json"),
+              JSON.stringify({
+                ...job,
+                connectionId: conn.id,
+                model: conn.model,
+                baseUrl: conn.baseUrl,
+                endpointId: conn.imageEndpointId,
+              }),
+            );
+          },
+          // No configured fallback is resolved for a studio request.
+        },
+      );
+      return await saveResult(body.assetId, image, conn.id, conn.model);
+    } catch (error) {
+      logger.warn(error, "Sprite studio generation failed; no automatic retry");
+      return reply.code(attempted ? 502 : 400).send({
+        error: error instanceof Error ? error.message : "Sprite generation failed.",
+        attempts: attempted ? 1 : 0,
+      });
+    }
+  });
+  app.post("/studio/recover", async (req, reply) => {
+    try {
+      const { assetId } = req.body as { assetId?: string };
+      if (!assetId || !assetPattern.test(assetId)) throw new Error("Invalid studio asset id.");
+      const dir = join(root, assetId);
+      try {
+        return JSON.parse(await readFile(join(dir, "studio-receipt.json"), "utf8"));
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      }
+      const job = JSON.parse(await readFile(join(dir, "studio-provider-job.json"), "utf8"));
+      const conn = await connection(job.connectionId);
+      if (conn.model !== job.model || conn.baseUrl !== job.baseUrl || conn.imageEndpointId !== job.endpointId)
+        throw new Error("The connection changed since submission. Restore it before recovering the existing job.");
+      const request = { prompt: "", allowRetries: false, signal: AbortSignal.timeout(30_000) };
+      const image =
+        job.source === "comfyui"
+          ? await resumeComfyUiImage(conn.baseUrl || "", job.id, request)
+          : job.source === "runpod_comfyui"
+            ? await resumeRunPodImage(
+                conn.baseUrl || "",
+                conn.imageEndpointId || "",
+                conn.apiKey || "",
+                job.id,
+                request,
+              )
+            : null;
+      if (!image) throw new Error("This provider does not support job recovery.");
+      return await saveResult(assetId, image, conn.id, conn.model);
+    } catch (error) {
+      return reply
+        .code(409)
+        .send({ error: error instanceof Error ? error.message : "The original is not available yet.", attempts: 0 });
+    }
+  });
+}
