@@ -0,0 +1,50 @@
+import { isOpenAIGptImageModel, supportsOpenAIImageCustomSize } from "@marinara-engine/shared";
+
+export type StudioCanvas = { width: number; height: number };
+export type StudioBatch = StudioCanvas & { cols: number; rows: number; count: number };
+
+/** Conservative adapter sizes. Unknown/proxied models get a single square canvas,
+ * rather than promising a larger output their adapter cannot request. */
+export function studioCanvases(model: string, source: string): StudioCanvas[] {
+  if (isOpenAIGptImageModel(model)) {
+    const sizes = [
+      { width: 1024, height: 1024 },
+      { width: 1024, height: 1536 },
+      { width: 1536, height: 1024 },
+    ];
+    if (supportsOpenAIImageCustomSize(model)) sizes.push({ width: 1536, height: 1536 }, { width: 1536, height: 2304 });
+    return sizes;
+  }
+  if (["comfyui", "swarmui", "automatic1111", "runpod_comfyui"].includes(source))
+    return [
+      { width: 512, height: 768 },
+      { width: 1024, height: 1536 },
+      { width: 1536, height: 1536 },
+    ];
+  return [{ width: 1024, height: 1024 }];
+}
+
+export function planStudioSheets(count: number, canvases: StudioCanvas[], individual = false): StudioBatch[] {
+  if (!Number.isInteger(count) || count < 1 || count > 24) throw new Error("Choose between 1 and 24 expressions.");
+  const batches: StudioBatch[] = [];
+  while (count > 0) {
+    const choices: StudioBatch[] = [];
+    for (const canvas of canvases) {
+      for (let cols = 1; cols <= 3; cols++)
+        for (let rows = 1; rows <= 3; rows++) {
+          const cells = cols * rows;
+          if (cells > 6 || (individual && cells !== 1) || canvas.width / cols < 512 || canvas.height / rows < 768)
+            continue;
+          choices.push({ ...canvas, cols, rows, count: Math.min(count, cells) });
+        }
+    }
+    choices.sort(
+      (a, b) => b.count - a.count || a.width * a.height - b.width * b.height || a.cols * a.rows - b.cols * b.rows,
+    );
+    const next = choices[0];
+    if (!next) throw new Error("This connection cannot supply a 512 by 768 sprite cell.");
+    batches.push(next);
+    count -= next.count;
+  }
+  return batches;
+}
