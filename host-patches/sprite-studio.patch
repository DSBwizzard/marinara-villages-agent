+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { readFile, mkdir, writeFile } from "node:fs/promises";
+import { generateImage } from "../../packages/server/src/services/image/image-generation.js";
+import { join } from "node:path";
+import { createRequire } from "node:module";
+const serverRequire = createRequire(new URL("../../packages/server/package.json", import.meta.url));
+const Fastify = serverRequire("fastify");
+const sharp = serverRequire("sharp");
+import { studioCanvases, planStudioSheets } from "../../packages/server/src/services/image/sprite-studio.js";
+import { spriteStudioRoutes } from "../../packages/server/src/routes/sprite-studio.routes.js";
+import { DATA_DIR } from "../../packages/server/src/utils/data-dir.js";
+
+async function main() {
+  const square = studioCanvases("proxy-image", "gemini_image");
+  assert.equal(planStudioSheets(5, square).length, 3);
+  const large = [{ width: 1536, height: 1536 }];
+  assert.equal(planStudioSheets(5, large).length, 1);
+  assert.equal(planStudioSheets(5, large, true).length, 5);
+  assert.throws(() => planStudioSheets(0, large));
+  for (const batch of planStudioSheets(24, studioCanvases("gpt-image-1", "openai"))) {
+    assert.ok(batch.cols * batch.rows <= 6);
+    assert.ok(batch.width / batch.cols >= 512 && batch.height / batch.rows >= 768);
+  }
+  const app = Fastify();
+  const conn = {
+    id: "fixture",
+    provider: "image_generation",
+    name: "Fixture",
+    model: "gpt-image-1",
+    imageService: "openai",
+    comfyuiWorkflow: "",
+    imageEndpointId: "",
+    baseUrl: "https://api.openai.com/v1",
+    apiKeyEncrypted: "",
+  };
+  app.decorate("db", { select: () => ({ from: () => ({ where: async () => [conn] }) }) });
+  await spriteStudioRoutes(app);
+  const image = (
+    await sharp({ create: { width: 1024, height: 1536, channels: 4, background: "#ffffff00" } })
+      .png()
+      .toBuffer()
+  ).toString("base64");
+  let calls = 0,
