{
  "name": "marinara-villages-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Villages optional Marinara agent; repository-owned build and validation tools.",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@types/node": "24.13.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "adm-zip": "0.6.1",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fastify": "5.12.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "zod": "3.25.76"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:engine-types && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --project tsconfig.package.json --pretty false",
    "build": "node scripts/build-villages.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node scripts/run-tests.mjs regression",
    "test:browser": "node scripts/run-tests.mjs browser",
    "test:engine": "node scripts/run-tests.mjs engine",
    "test:inventory": "node scripts/run-tests.mjs --list",
    "validate": "npm run check && npm run build && npm run verify:package && npm run test:review",
    "format": "prettier --write \"packages/**/src/**/*.{js,mjs,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,mjs,ts,tsx}\" eslint.config.mjs \"packages/villages/*.mjs\" \"sources/package-shared.ts\" tsconfig.package.json",
    "format:check": "prettier --check \"packages/**/src/**/*.{js,mjs,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,mjs,ts,tsx}\" eslint.config.mjs \"packages/villages/*.mjs\" \"sources/package-shared.ts\" tsconfig.package.json",
    "lint": "eslint \"packages/**/src/**/*.{js,mjs,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,mjs,ts,tsx}\" eslint.config.mjs \"packages/villages/*.mjs\" \"sources/package-shared.ts\"",
    "check:engine-types": "node scripts/engine-public-declarations.mjs",
    "test:review": "node scripts/run-tests.mjs review",
    "verify:build": "node scripts/verify-build.mjs"
  }
}
